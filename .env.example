# Include cloudflared in `docker compose up -d`. Remove this line to run locally without the tunnel.
COMPOSE_PROFILES=tunnel
# Token from Cloudflare Zero Trust → Networks → Tunnels (public hostname → http://web:80).
CLOUDFLARE_TUNNEL_TOKEN=

# Shared key for the demo: open the site as https://<host>/?key=<DEMO_KEY>. Empty = no check.
DEMO_KEY=

# Local port for nginx (bound to 127.0.0.1 only).
WEB_PORT=8080

# ---- Call: Groq Whisper (STT) -> LLM -> ElevenLabs v4 (TTS). Keys stay on the server. ----
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# LLM fallback list "model[:reasoning_effort]": on 429/5xx the same turn goes to the next model
# (free-tier limits are per model). The effort defaults to GROQ_REASONING_EFFORT.
GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b:low,openai/gpt-oss-20b:low
# none for Qwen; gpt-oss models need low|medium|high.
GROQ_REASONING_EFFORT=none
# 1 = local LLM_MODEL (Ollama, container `llm`) answers when all Groq models are rate-limited.
# It is loaded at bot startup and stays in VRAM (~4 GB).
CLOUD_LLM_LOCAL_FALLBACK=0
LLM_MODEL=qwen3:4b-instruct
# Ollama home on the host (contains models/).
OLLAMA_HOST_DIR=./models/ollama
LLM_TEMPERATURE=0.8
CLOUD_LLM_MAX_TOKENS=200
# How many recent messages (user + bot) the LLM sees.
CLOUD_HISTORY_MESSAGES=30
# ElevenLabs Text-to-Dialogue (v4 Turbo), voice from your ElevenLabs voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo

MAX_CALL_SECONDS=600
IDLE_TIMEOUT_SECONDS=60
# Loudness (0..1) a sound needs to count as speech; higher ignores a TV in the background.
VAD_MIN_VOLUME=0.75
