# Include cloudflared in `docker compose up -d`. Remove this line to run locally without the tunnel.
COMPOSE_PROFILES=tunnel
# Token from Cloudflare Zero Trust → Networks → Tunnels (public hostname → http://web:80).
CLOUDFLARE_TUNNEL_TOKEN=

# Shared key for the demo: open the site as https://<host>/?key=<DEMO_KEY>. Empty = no check.
DEMO_KEY=

# Where models live on the host. Defaults: ./models/ollama and ./models.
# OLLAMA_HOST_DIR is an Ollama home (contains models/); MODELS_HOST_DIR holds whisper/ and piper/.
OLLAMA_HOST_DIR=./models/ollama
MODELS_HOST_DIR=./models

# Local port for nginx (bound to 127.0.0.1 only).
WEB_PORT=8080

LLM_MODEL=qwen3:4b-instruct
LLM_MAX_TOKENS=100
LLM_TEMPERATURE=0.8
# How many recent messages (user + bot) to keep in the LLM context.
LLM_HISTORY_MESSAGES=16

# large-v3-turbo: much better Russian than small at ~1.6 GB VRAM (fp16). small/medium also work.
WHISPER_MODEL=large-v3-turbo
# Piper voices to download; each persona picks one in its frontmatter (voice:).
PIPER_VOICES="ru_RU-irina-medium ru_RU-dmitri-medium ru_RU-ruslan-medium ru_RU-denis-medium"

# Gemini Live engine (chosen in the web UI). Key from https://aistudio.google.com/apikey;
# empty = the Gemini option is shown as disabled. Audio goes to Google when it is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live

# Engine whose GPU models are loaded at startup (local | higgs | espeech | ...). Switching engines
# unloads the previous engine's models first: only one heavy model fits in 12 GB.
PRELOAD_ENGINE=local

# ---- Cascade engines: STT -> cloud LLM -> expressive TTS (cloud, fish, higgs, espeech) ----
# All keys stay on the server; an engine without its keys is shown as disabled with the reason.
# LLM: gemini (GEMINI_API_KEY above) | groq
CLOUD_LLM_PROVIDER=gemini
# 3.8/3.7 flash are often overloaded (503/timeouts) on the free tier; 3.5 answers in ~1 s.
GEMINI_TEXT_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# none for Qwen; gpt-oss models need low|medium|high.
GROQ_REASONING_EFFORT=none
CLOUD_LLM_MAX_TOKENS=200
CLOUD_HISTORY_MESSAGES=80
# STT: auto = deepgram if DEEPGRAM_API_KEY, else groq if GROQ_API_KEY, else local Whisper (GPU).
# The full-cloud engine (ElevenLabs) needs deepgram or groq.
CASCADE_STT=auto
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-multi
GROQ_STT_MODEL=whisper-large-v3-turbo
# Engine "cloud": ElevenLabs Text-to-Dialogue (v4 Turbo), voice from your ElevenLabs voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo
# Engine "fish": Fish Audio cloud API; s2.1-pro-free is the free tier of S2.1 Pro.
# FISH_REFERENCE_ID = voice model id on fish.audio (empty = default voice).
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_MODEL=s2.1-pro-free
# Engines "higgs" / "espeech": local TTS containers (compose profiles higgs / espeech), weights in
# ${MODELS_HOST_DIR}/higgs and ${MODELS_HOST_DIR}/espeech, reference voices in ${MODELS_HOST_DIR}/voices.
HIGGS_URL=http://tts-higgs:9000
ESPEECH_URL=http://tts-espeech:9000

MAX_CALL_SECONDS=600
IDLE_TIMEOUT_SECONDS=60
